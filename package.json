{
  "name": "avivet-icons",
  "version": "0.3.1",
  "private": true,
  "description": "AviVet Icons — Open Source Poultry Design System",
  "license": "MIT",
  "author": "Andres Lazo",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "build:site": "pnpm run build && pnpm --filter website build",
    "sketch": "tsx scripts/sketch.ts",
    "new": "tsx scripts/new-icon.ts",
    "dev": "pnpm run build && pnpm --filter website dev",
    "test": "pnpm run build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.18.13",
    "@types/react": "^19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "svgo": "^4.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.1.12",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "icons",
    "svg",
    "poultry",
    "aviculture",
    "veterinary",
    "design-system",
    "avivet"
  ]
}
